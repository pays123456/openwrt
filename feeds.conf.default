# ============================================================
#  feeds.conf.default  GL-MT3600BE
#  Upstream: OpenWrt 25.12.5 (GL-MT3600BE native + security fixes)
#  Extra: FanchmWrt 25.12.4 (fwx / fwxd / fullconenat / feeds_patches)
#
#  All feeds locked to specific commit for reproducible build.
#  Remove ^<hash> if you want follow latest HEAD (not recommended for release)
# ============================================================
# ---- Official 4 feeds (commit for OpenWrt 25.12.5) ----
src-git packages https://git.openwrt.org/feed/packages.git^f91b06b3faff7ad3c8cbeb1ab39cef680d2f28ed
src-git luci     https://git.openwrt.org/project/luci.git^e9ebca7598ce2f754b76267fd66bf2b85e6e4347
src-git routing  https://git.openwrt.org/feed/routing.git^b2097c85bef85251364f59a6b2a3ed1f9f5c0c21
src-git telephony https://git.openwrt.org/feed/telephony.git^2618106d5846a4a542fdf5809f0d3ed228ce439b
#src-git video    https://github.com/openwrt/video.git^094bf58da6682f895255a35a84349a79dab4bf95
# ---- FanchmWrt custom packages ----
# fanchmwrt-packages repo only has main branch
src-git fanchmwrt https://github.com/fanchmwrt/fanchmwrt-packages.git;main
# After first successful build, lock to fixed commit:
# cd fanchmwrt-packages && git log -1 --format=%H
# src-git fanchmwrt https://github.com/fanchmwrt/fanchmwrt-packages.git^PUT_COMMIT_HASH_HERE
